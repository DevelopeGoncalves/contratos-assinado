rules_version = '2';

// ============================================================================
//  Regras do Firestore — Sistema de Contratos Victorino Eng
// ----------------------------------------------------------------------------
//  Como aplicar:
//   Console do Firebase -> Firestore Database -> aba "Regras" ->
//   cole este conteúdo -> "Publicar".
//
//  MODELO DE SEGURANÇA:
//   • config/contrato  -> leitura pública (o cliente precisa ver os valores);
//                         ESCRITA só para o admin logado (Firebase Auth).
//   • contratos/{id}   -> o cliente pode APENAS CRIAR o próprio registro, e
//                         somente com os VALORES iguais aos do config (não
//                         consegue alterar preço, carência, etc.).
//                         LER / EDITAR / EXCLUIR: só o admin logado.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Dados do config (valores fixos vêm daqui).
    function cfg() {
      return get(/databases/$(database)/documents/config/contrato).data;
    }

    // Dados de um link de contrato específico (valores próprios de um cliente).
    function linkData(id) {
      return get(/databases/$(database)/documents/links/$(id)).data;
    }

    // Confere se os valores enviados batem EXATAMENTE com a fonte (config ou link).
    function valoresBatem(src) {
      return request.resource.data.objeto == src.objeto
        && request.resource.data.valorSetup == src.valorSetup
        && request.resource.data.valorMensalidade == src.valorMensalidade
        && request.resource.data.diaVencimento == src.diaVencimento
        && request.resource.data.cidadeAssinatura == src.cidadeAssinatura
        && request.resource.data.ufAssinatura == src.ufAssinatura
        && request.resource.data.fidelidadeMeses == src.fidelidadeMeses
        && request.resource.data.reajustePercent == src.reajustePercent;
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Links de contrato: leitura pública (o cliente precisa ver os valores do
    // link dele); criar/editar/excluir só o admin logado.
    match /links/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /contratos/{id} {
      // Somente o admin logado lê, edita ou exclui.
      allow read, update, delete: if request.auth != null;

      // Criação pública pelo cliente: precisa nascer "pendente" e com os
      // valores EXATAMENTE iguais aos definidos pelo admin. A fonte dos valores
      // é o LINK do cliente (quando enviado linkId) ou o config padrão.
      allow create: if request.resource.data.status == 'pendente' && (
        (
          'linkId' in request.resource.data
          && request.resource.data.linkId is string
          && request.resource.data.linkId.size() > 0
          && valoresBatem(linkData(request.resource.data.linkId))
        ) || (
          !('linkId' in request.resource.data)
          && valoresBatem(cfg())
        )
      );
    }
  }
}
