rules_version = '2';

// ============================================================================
//  Regras do Firestore — Sistema de Contratos Victorino Eng
// ----------------------------------------------------------------------------
//  Como aplicar:
//   Console do Firebase -> Firestore Database -> aba "Regras" ->
//   cole este conteúdo -> "Publicar".
//
//  MODELO DE SEGURANÇA:
//   • config/contrato  -> leitura pública (o cliente precisa ver os valores);
//                         ESCRITA só para o admin logado (Firebase Auth).
//   • contratos/{id}   -> o cliente pode APENAS CRIAR o próprio registro, e
//                         somente com os VALORES iguais aos do config (não
//                         consegue alterar preço, carência, etc.).
//                         LER / EDITAR / EXCLUIR: só o admin logado.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Dados do config (valores fixos vêm daqui).
    function cfg() {
      return get(/databases/$(database)/documents/config/contrato).data;
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /contratos/{id} {
      // Somente o admin logado lê, edita ou exclui.
      allow read, update, delete: if request.auth != null;

      // Criação pública pelo cliente: precisa nascer "pendente" e com os
      // valores EXATAMENTE iguais aos definidos pelo admin no config.
      allow create: if request.resource.data.status == 'pendente'
        && request.resource.data.objeto == cfg().objeto
        && request.resource.data.valorSetup == cfg().valorSetup
        && request.resource.data.valorMensalidade == cfg().valorMensalidade
        && request.resource.data.diaVencimento == cfg().diaVencimento
        && request.resource.data.cidadeAssinatura == cfg().cidadeAssinatura
        && request.resource.data.ufAssinatura == cfg().ufAssinatura
        && request.resource.data.fidelidadeMeses == cfg().fidelidadeMeses
        && request.resource.data.reajustePercent == cfg().reajustePercent;
    }
  }
}
